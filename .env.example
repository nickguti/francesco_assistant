# Chiave API per Google Gemini (Richiesta per le risposte dell'assistente)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Parola chiave per l'attivazione vocale (default: francesco)
WAKE_WORD=francesco

# Lingua e Voce predefinita per edge-tts (es: it-IT-GiuseppeNeural, it-IT-ElsaNeural)
TTS_VOICE=it-IT-GiuseppeNeural

# Configurazione opzionale per ElevenLabs (Lasciare vuoti se si usa edge-tts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
